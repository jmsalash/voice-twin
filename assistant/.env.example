# Copy to assistant/.env (git-ignored) and fill in.
MODEL_DIR=/path/to/fine-tuned/ckpt        # folder with lit_model.pth, tokenizer.json, rephrase.wav, rephrase.txt
ALLOWED_ORIGINS=https://example.com       # your site; empty = any origin (testing only)
TURNSTILE_SECRET=                         # Cloudflare Turnstile secret key; empty = no check
MAX_SESSIONS=4
SLOTS=4
ASR_MODEL=                                # optional: faster-whisper folder (large-v3-turbo) for better hearing, +0.3 s
TUNNEL_TOKEN=                             # only for --profile tunnel
